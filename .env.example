# Local examples only. Replace the password in BOTH values before starting.
# Use a URL-safe password (letters/digits), or percent-encode it in DATABASE_URL.
POSTGRES_DB=baso_kang_gito
POSTGRES_USER=baso
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://baso:replace-with-a-local-password@127.0.0.1:5432/baso_kang_gito
HOST=127.0.0.1
PORT=3000
ENABLE_DEV_BOOKKEEPING=false
# Isolated port-3001 test-helper controls only. The regular API never accepts this token.
# Generate a private random token before enabling that helper; never use it in production.
BOOKKEEPING_DEV_TOKEN=
