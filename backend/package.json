{
  "name": "baso-kang-gito-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.20.0 <23" },
  "scripts": {
    "dev": "node --env-file=../.env --watch --import tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --env-file=../.env --import tsx --test test/*.integration.ts",
    "db:migrate": "npm run build && node --env-file-if-exists=../.env dist/migrate.js"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "kysely": "^0.28.8",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
